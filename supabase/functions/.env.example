# Edge Function env for local runs: copy to supabase/functions/.env (git-ignored).
# Loaded automatically by `npm run db:start` (restart the stack after changing it) and by `npm run functions:serve`.
# Remote: npx supabase secrets set --env-file supabase/functions/.env
# Sophos Central credential: normally entered by an admin in Settings > Sophos Central (stored in Vault).
# Optional fallback for automated setups, used only while Settings has no credential.
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
# Live Endpoint Search GraphQL URL. Validated Oct 26, 2026 with a Sophos Central token + X-Tenant-ID:
#   https://api.taegis.sophos.com/graphql   (unset = Live Discover REST fallback)
SOPHOS_LES_URL=
# Shared secret that pg_cron sends in x-collector-secret (also stored in Vault)
COLLECTOR_SECRET=
# Dictionary Hub: normally entered by an admin in Settings > Dictionary hub (key stored in Vault).
# Optional fallback, used only while Settings has none. Local mock: npm run mock:hub, then
#   http://host.docker.internal:54998 with the key mock-hub-client-key-0123456789
HUB_URL=
HUB_CLIENT_KEY=
# Test only: point the functions at local mocks (npm run mock:sophos, npm run mock:alerts). Leave empty in real use.
RESEND_API_URL=
SOPHOS_ID_URL=
SOPHOS_GLOBAL_URL=
