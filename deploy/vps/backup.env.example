# Copy to /opt/endpoint-inventory/backup.env (mode 600). systemd reads it (EnvironmentFile): one KEY=value per line,
# no quotes needed, any characters allowed in values (the scripts never parse this file themselves).
# KEEP=14
OFFSITE_ENABLED=1
# Public key only; the private key (age-keygen -o key.txt) stays offline, never on this server.
AGE_RECIPIENT=age1examplepublickeyxxxxxxxx
# rclone remote:path, remotes defined in /opt/endpoint-inventory/rclone.conf (mode 600). Leave a line out to skip the target.
OFFSITE_S3=r2:bucket/inventory
OFFSITE_FTP=sftp-backup:inventory
# Email (all five needed). The encrypted file must be at most OFFSITE_EMAIL_MAX_MB megabytes.
OFFSITE_EMAIL_TO=backup@example.test
OFFSITE_EMAIL_FROM=inventory@example.test
OFFSITE_EMAIL_MAX_MB=20
SMTP_URL=smtps://mail.example.test:465
SMTP_USER=inventory@example.test
SMTP_PASS=change-me
# 1 = also send the Vault key (encrypted). Default 0: copy pgsodium_root.key off the host by hand.
OFFSITE_SEND_KEY=0
