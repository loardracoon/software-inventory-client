# Gateway of one app (Service "kong", port 8000, so database jobs keep calling http://kong:8000/functions/v1/...):
# the built front end plus the Supabase APIs on the same host, and Mailpit (magic links) behind basic auth.
#
# Template: the nginx image fills ${RL_*} from the environment at start (web.Dockerfile sets the defaults; the
# deployment overrides them from rate-limits.env). README › Rate limits explains each value.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# Client IP behind the proxy in front of this gateway (Traefik on K3S, the tls container on the VPS). Only
# addresses of private networks are trusted to report it, so a client cannot choose its own address.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Requests from outside always pass that proxy, which adds X-Forwarded-For. Calls between services (Edge
# Functions to PostgREST and Auth, database jobs to Edge Functions) have none and are not limited here.
map $http_x_forwarded_for $rl_key {
  ""      "";
  default $binary_remote_addr;
}
map $http_x_forwarded_for $rl_client_ip {
  ""      "";
  default $remote_addr;
}

limit_req_zone $rl_key zone=auth_strict:10m rate=${RL_AUTH_STRICT_RATE};
limit_req_zone $rl_key zone=auth:10m rate=${RL_AUTH_RATE};
limit_req_zone $rl_key zone=rest:10m rate=${RL_REST_RATE};
limit_req_zone $rl_key zone=functions:10m rate=${RL_FUNCTIONS_RATE};
limit_conn_zone $rl_key zone=per_ip:10m;
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;

server {
  listen 8000;
  server_name _;
  root /usr/share/nginx/html;

  # Slow clients (slowloris) and oversized requests.
  client_header_timeout 15s;
  client_body_timeout 30s;
  send_timeout 60s;
  keepalive_timeout 30s;
  client_max_body_size ${RL_BODY_FUNCTIONS};
  limit_conn per_ip ${RL_CONN_PER_IP};

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

  # Sign-in, sign-up, magic link and code checks: few per address (GoTrue also limits them per address,
  # keyed by X-Real-IP; an empty value, for calls between services, is not limited there either).
  location ~ ^/auth/v1/(otp|magiclink|signup|recover|resend|verify)$ {
    limit_req zone=auth_strict burst=${RL_AUTH_STRICT_BURST} nodelay;
    client_max_body_size ${RL_BODY_AUTH};
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_set_header X-Real-IP $rl_client_ip;
    proxy_pass http://auth:9999;
  }

  location /auth/v1/ {
    limit_req zone=auth burst=${RL_AUTH_BURST} nodelay;
    client_max_body_size ${RL_BODY_AUTH};
    proxy_set_header X-Real-IP $rl_client_ip;
    proxy_pass http://auth:9999/;
  }

  location /rest/v1/ {
    limit_req zone=rest burst=${RL_REST_BURST} nodelay;
    client_max_body_size ${RL_BODY_REST};
    proxy_pass http://rest:3000/;
  }

  location /functions/v1/ {
    limit_req zone=functions burst=${RL_FUNCTIONS_BURST} nodelay;
    proxy_pass http://functions:9000/;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
  }

  # Basic auth guesses are limited like the auth API (the Mailpit page loads several files at once).
  location /mail/ {
    limit_req zone=auth burst=${RL_AUTH_BURST} nodelay;
    auth_basic "Mail";
    auth_basic_user_file /etc/nginx/auth/htpasswd;
    proxy_pass http://mailpit:8025;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
