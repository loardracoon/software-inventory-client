# Rate limits and abuse protection (README › Rate limits and abuse protection).
# Docker Compose loads this file into the gateway (kong), Auth and the Edge Functions (env_file in
# docker-compose.yml). After a change: docker compose up -d (update.sh does it too).
# Values below are the recommended ones for a team of up to ~50 users behind one office address.

# --- Gateway (nginx in the web image), per client address -------------------------------------------------------
# Rates: Nr/s or Nr/m (leaky bucket). Burst: requests above the rate accepted at once before HTTP 429.
# Sign-in, sign-up, magic link and code checks (/auth/v1/otp|magiclink|signup|recover|resend|verify)
RL_AUTH_STRICT_RATE=10r/m
RL_AUTH_STRICT_BURST=10
# Other Auth calls (session refresh, user) and the Mailpit page (/mail/)
RL_AUTH_RATE=120r/m
RL_AUTH_BURST=60
# Database API used by every screen (a page sends 10 to 30 requests at once)
RL_REST_RATE=30r/s
RL_REST_BURST=120
# Edge Functions (Sync now, Scan now, exports, policy evaluation)
RL_FUNCTIONS_RATE=10r/s
RL_FUNCTIONS_BURST=60
# Open connections per client address
RL_CONN_PER_IP=60
# Largest request body (k or m)
RL_BODY_AUTH=64k
RL_BODY_REST=2m
RL_BODY_FUNCTIONS=10m

# --- Auth (GoTrue) ----------------------------------------------------------------------------------------------
# Per-address limits work only with a header that carries the client address; the gateway sets X-Real-IP.
# Without this line GoTrue applies none of the per-address limits below.
GOTRUE_RATE_LIMIT_HEADER=X-Real-IP
# Sign-in and sign-up requests per address per 5 minutes
GOTRUE_RATE_LIMIT_OTP=10
# Magic link and code checks per address per 5 minutes
GOTRUE_RATE_LIMIT_VERIFY=15
# Session refreshes per address per 5 minutes
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=60
# Emails Auth sends per hour, for the whole app (sign-in links and invitations)
GOTRUE_RATE_LIMIT_EMAIL_SENT=60

# --- Edge Functions ---------------------------------------------------------------------------------------------
# Invitations and sign-in links an admin sends from Settings › Users and access, per admin per hour
RL_INVITES_PER_HOUR=20
