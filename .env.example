# Front end (safe to expose: anon key only, RLS protects the data)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets: set with `supabase secrets set`, never commit real values
# Sophos Central credential: normally entered by an admin in Settings > Sophos Central (stored in Vault).
# Optional fallback for automated setups, used only while Settings has no credential.
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
# Live Endpoint Search GraphQL URL. Validated Oct 26, 2026 with a Sophos Central token + X-Tenant-ID:
#   https://api.taegis.sophos.com/graphql   (unset = Live Discover REST fallback)
SOPHOS_LES_URL=
# Shared secret that pg_cron sends in x-collector-secret (also stored in Vault)
COLLECTOR_SECRET=
# Dictionary Hub (Phase 7)
HUB_URL=https://<hub-project>.supabase.co
HUB_CLIENT_KEY=
